<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SecureCRT - [Tile Vertically - 10 Sessions]</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap');
    body {
      font-family: 'Segoe UI', 'Malgun Gothic', sans-serif;
      background-color: #d4d0c8;
      margin: 0;
      padding: 0;
      overflow: hidden;
      user-select: none;
    }
    .term-font {
      font-family: 'JetBrains Mono', 'Consolas', 'Courier New', monospace;
    }
    /* 클래식 SecureCRT 윈도우 창 테두리 스타일 */
    .crt-window {
      border: 1px solid #7f9db9;
      background-color: #0c0c0c;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: inset 0 0 0 1px #ffffff33;
    }
    .crt-titlebar {
      background: linear-gradient(90deg, #0054e3 0%, #2785ff 65%, #0054e3 100%);
      color: #ffffff;
      font-size: 11px;
      font-weight: 600;
      padding: 2px 6px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      letter-spacing: -0.2px;
      flex-shrink: 0;
    }
    .crt-titlebar.inactive {
      background: linear-gradient(90deg, #7a96df 0%, #9db6f5 100%);
    }
    .crt-win-btns span {
      display: inline-block;
      width: 13px;
      height: 13px;
      line-height: 11px;
      text-align: center;
      background: #ece9d8;
      color: #000;
      border: 1px solid #fff;
      border-right-color: #404040;
      border-bottom-color: #404040;
      font-size: 9px;
      margin-left: 1px;
    }
    .crt-body {
      flex: 1;
      padding: 4px 6px;
      color: #cccccc;
      font-size: 10.5px;
      line-height: 1.32;
      overflow-y: hidden;
      white-space: pre-wrap;
      word-break: break-all;
    }
    .log-ok { color: #a6e22e; }
    .log-info { color: #cccccc; }
    .log-warn { color: #fd971f; }
    .log-err { color: #ff4d4d; font-weight: 700; }
    .log-sec { color: #ff66b3; font-weight: 700; }
    .log-path { color: #66d9ef; }
    .cursor-block {
      display: inline-block;
      width: 6px;
      height: 11px;
      background-color: #00ff66;
      vertical-align: middle;
      animation: blink 1s step-end infinite;
    }
    @keyframes blink {
      50% { opacity: 0; }
    }
    /* 10개 세로 타일 분할 그리드 (5열 x 2행 또는 10열 세로 분할 전환 지원) */
    .tile-grid-5x2 {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      grid-template-rows: repeat(2, 1fr);
      gap: 2px;
      height: calc(100vh - 74px);
      background-color: #808080;
      padding: 2px;
    }
    .tile-grid-10col {
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      grid-template-rows: 1fr;
      gap: 2px;
      height: calc(100vh - 74px);
      background-color: #808080;
      padding: 2px;
    }
  </style>
</head>
<body>

  <!-- SecureCRT 상단 메인 타이틀 바 -->
  <div class="bg-[#0054e3] text-white text-xs px-2.5 py-1 flex justify-between items-center font-semibold">
    <div class="flex items-center gap-2">
      <span class="bg-white text-[#0054e3] font-extrabold px-1.5 rounded-sm text-[10px]">CRT</span>
      <span>SecureCRT - [10 Active Sessions - Tile Vertically]</span>
    </div>
    <div class="text-[11px] opacity-90">전자통관 운영서버 실시간 로그 수동 점검 화면 (시연 연출용)</div>
  </div>

  <!-- SecureCRT 메뉴 및 툴바 (녹화 중 모드 전환 컨트롤 포함) -->
  <div class="bg-[#ece9d8] border-b border-[#aca899] px-2 py-1 flex flex-wrap justify-between items-center text-xs text-black gap-2">
    <div class="flex items-center gap-3">
      <span class="cursor-pointer hover:underline">File</span>
      <span class="cursor-pointer hover:underline">Edit</span>
      <span class="cursor-pointer hover:underline">View</span>
      <span class="cursor-pointer hover:underline">Options</span>
      <span class="cursor-pointer hover:underline">Transfer</span>
      <span class="cursor-pointer hover:underline">Script</span>
      <span class="font-bold text-[#0054e3]">Window (Tile Vertically)</span>
      <span class="cursor-pointer hover:underline">Help</span>
    </div>

    <!-- 동영상 촬영 연출용 컨트롤 버튼 -->
    <div class="flex items-center gap-1.5">
      <span class="text-[11px] text-gray-600 font-semibold mr-1">촬영 연출 제어:</span>
      <button id="btnLayout5x2" onclick="setLayout('5x2')" class="px-2 py-0.5 bg-white border border-gray-400 rounded text-[11px] font-bold text-blue-700 shadow-sm">
        5×2 타일 분할
      </button>
      <button id="btnLayout10" onclick="setLayout('10col')" class="px-2 py-0.5 bg-[#f5f4ea] border border-gray-400 rounded text-[11px] text-gray-700 hover:bg-white">
        10열 세로 분할
      </button>
      <span class="mx-1 text-gray-400">|</span>
      <button id="btnNormal" onclick="setMode('normal')" class="px-2.5 py-0.5 bg-emerald-600 text-white rounded text-[11px] font-bold shadow-sm">
        평상시 로그
      </button>
      <button id="btnSurge" onclick="setMode('surge')" class="px-2.5 py-0.5 bg-gray-200 text-gray-800 border border-gray-400 rounded text-[11px] font-bold hover:bg-red-600 hover:text-white">
        폭주·오류 혼란 연출
      </button>
    </div>
  </div>

  <!-- 10개 세션 탭 바 -->
  <div id="tabBar" class="bg-[#d8d4c8] border-b border-[#808080] px-1 pt-1 flex gap-0.5 overflow-hidden text-[11px]"></div>

  <!-- 10개 터미널 타일 컨테이너 -->
  <div id="tileContainer" class="tile-grid-5x2"></div>

  <script>
    // 관세행정 · 유니패스 · 전자상거래 주요 10대 서버 세션 정의
    const SESSIONS = [
      { id: 0, host: 'CUS-WEB-01', ip: '10.10.1.11', cmd: 'tail -f /logs/nginx/csp_access.log', type: 'WEB' },
      { id: 1, host: 'CUS-WEB-02', ip: '10.10.1.12', cmd: 'tail -f /logs/nginx/csp_error.log', type: 'WEB' },
      { id: 2, host: 'CUS-WAS-01', ip: '10.10.2.21', cmd: 'tail -f /logs/jeus/csp_server1.log', type: 'WAS' },
      { id: 3, host: 'CUS-WAS-02', ip: '10.10.2.22', cmd: 'tail -f /logs/jeus/csp_server2.log', type: 'WAS' },
      { id: 4, host: 'CUS-DB-01',  ip: '10.10.3.31', cmd: 'tail -f /logs/tibero/alert_cusdb.log', type: 'DB'  },
      { id: 5, host: 'UNI-WEB-01', ip: '10.20.1.11', cmd: 'tail -f /logs/nginx/clip_access.log', type: 'WEB' },
      { id: 6, host: 'UNI-WAS-01', ip: '10.20.2.21', cmd: 'tail -f /logs/jeus/clip_server1.log', type: 'WAS' },
      { id: 7, host: 'UNI-DB-01',  ip: '10.20.3.31', cmd: 'tail -f /logs/tibero/alert_unidb.log', type: 'DB'  },
      { id: 8, host: 'ECM-WEB-01', ip: '10.30.1.11', cmd: 'tail -f /logs/nginx/rip_access.log', type: 'WEB' },
      { id: 9, host: 'ECM-WAS-01', ip: '10.30.2.21', cmd: 'tail -f /logs/jeus/rip_server1.log', type: 'WAS' },
    ];

    const PATHS = [
      '/csp/main/index.do',
      '/csp/edi/receiveDoc.do',
      '/clip/cargo/trackStatus.do',
      '/clip/import/declarationView.do',
      '/rip/refund/checkEligibility.do',
      '/rip/notice/billStatus.do'
    ];

    const ATTACK_PATHS = [
      '/csp/cgi-bin/download.do?file=../../../../etc/passwd',
      '/clip/admin/config/.env',
      "/rip/api/userInfo.do?id=1' OR '1'='1",
      '/csp/clearance/batchProcess.do'
    ];

    let currentMode = 'normal'; // 'normal' | 'surge'
    const logBuffers = SESSIONS.map(() => []);
    const MAX_LINES = 26;

    function nowStr() {
      const d = new Date();
      const pad = (n, l = 2) => String(n).padStart(l, '0');
      return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}.${pad(d.getMilliseconds(), 3)}`;
    }

    function randInt(min, max) {
      return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    function pick(arr) {
      return arr[Math.floor(Math.random() * arr.length)];
    }

    // 초기 UI 렌더링
    function initUI() {
      const tabBar = document.getElementById('tabBar');
      const container = document.getElementById('tileContainer');

      tabBar.innerHTML = SESSIONS.map((s, idx) => `
        <div class="px-2 py-0.5 rounded-t border border-b-0 border-[#808080] flex items-center gap-1 whitespace-nowrap ${idx === 0 ? 'bg-white font-bold text-black' : 'bg-[#ece9d8] text-gray-700'}">
          <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
          <span>${s.host}</span>
        </div>
      `).join('');

      container.innerHTML = SESSIONS.map((s, idx) => `
        <div class="crt-window">
          <div class="crt-titlebar ${idx === 0 ? '' : 'inactive'}">
            <span class="truncate">[${idx + 1}] ${s.host} (${s.ip}) - SSH2</span>
            <div class="crt-win-btns flex-shrink-0"><span>_</span><span>□</span><span>×</span></div>
          </div>
          <div id="term-${s.id}" class="crt-body term-font"></div>
        </div>
      `).join('');

      // 초기 프롬프트 및 명령어 출력
      SESSIONS.forEach(s => {
        pushLog(s.id, `<span class="log-ok">[opsmgr@${s.host} ~]$</span> ${s.cmd}`);
        for (let i = 0; i < 8; i++) {
          generateLine(s);
        }
      });
      renderAllTerms();
    }

    function pushLog(id, htmlLine) {
      logBuffers[id].push(htmlLine);
      if (logBuffers[id].length > MAX_LINES) {
        logBuffers[id].shift();
      }
    }

    function generateLine(s) {
      const ts = nowStr();
      const ip = `192.0.2.${randInt(10, 99)}`;
      const atkIp = pick(['211.234.110.55', '203.0.113.45', '198.51.100.88']);

      if (currentMode === 'normal') {
        if (s.type === 'WEB') {
          const path = pick(PATHS);
          const ms = randInt(45, 220);
          pushLog(s.id, `<span class="log-info">${ts} ${ip} "POST <span class="log-path">${path}</span>" 200 ${ms}ms</span>`);
        } else if (s.type === 'WAS') {
          const tx = `TX-${randInt(100000, 999999)}`;
          const ms = randInt(80, 310);
          pushLog(s.id, `<span class="log-info">[${ts}] [INFO] [${tx}] Service completed in <span class="log-ok">${ms}ms</span> (Pool: ${randInt(18, 42)}/200)</span>`);
        } else {
          const scn = randInt(8400000, 8999999);
          pushLog(s.id, `<span class="log-info">[${ts}] LGWR: Redo log switch completed. SCN=${scn} ActiveSess=${randInt(24, 55)}</span>`);
        }
      } else {
        // 폭주 · 보안 침해 · 오류 혼란 연출 모드
        const r = Math.random();
        if (s.type === 'WEB') {
          if (r < 0.45) {
            const badPath = pick(ATTACK_PATHS);
            pushLog(s.id, `<span class="log-sec">${ts} [ALERT] ${atkIp} "GET ${badPath}" 403 BLOCKED</span>`);
          } else if (r < 0.8) {
            pushLog(s.id, `<span class="log-err">${ts} [ERROR] ${atkIp} "POST /csp/declarations/submit.do" 504 Gateway Timeout (3020ms)</span>`);
          } else {
            pushLog(s.id, `<span class="log-warn">${ts} [WARN] worker_connections 94% exceeded! Upstream queue full</span>`);
          }
        } else if (s.type === 'WAS') {
          if (r < 0.5) {
            pushLog(s.id, `<span class="log-err">[${ts}] [SEVERE] java.sql.SQLTransientConnectionException: ConnectionPool exhausted (200/200)</span>`);
          } else if (r < 0.85) {
            pushLog(s.id, `<span class="log-warn">[${ts}] [WARN] StuckThreadMaxTime exceeded! Thread-Exec-${randInt(10, 99)} running 4,820ms</span>`);
          } else {
            pushLog(s.id, `<span class="log-err">[${ts}] [ERROR] HTTP 503 Service Unavailable - /clip/cargo/trackStatus.do</span>`);
          }
        } else {
          if (r < 0.55) {
            pushLog(s.id, `<span class="log-err">[${ts}] ORA-00020: maximum number of processes (500) exceeded! Lock wait detected</span>`);
          } else {
            pushLog(s.id, `<span class="log-warn">[${ts}] [WARN] Enqueue TX row lock contention on TB_IMP_DEC_MST (Sessions: 489)</span>`);
          }
        }
      }
    }

    function renderAllTerms() {
      SESSIONS.forEach(s => {
        const el = document.getElementById(`term-${s.id}`);
        if (el) {
          el.innerHTML = logBuffers[s.id].join('\n') + `\n<span class="log-ok">$</span> <span class="cursor-block"></span>`;
          el.scrollTop = el.scrollHeight;
        }
      });
    }

    function setMode(mode) {
      currentMode = mode;
      const btnN = document.getElementById('btnNormal');
      const btnS = document.getElementById('btnSurge');
      if (mode === 'normal') {
        btnN.className = 'px-2.5 py-0.5 bg-emerald-600 text-white rounded text-[11px] font-bold shadow-sm';
        btnS.className = 'px-2.5 py-0.5 bg-gray-200 text-gray-800 border border-gray-400 rounded text-[11px] font-bold hover:bg-red-600 hover:text-white';
      } else {
        btnN.className = 'px-2.5 py-0.5 bg-gray-200 text-gray-800 border border-gray-400 rounded text-[11px] font-bold hover:bg-emerald-600 hover:text-white';
        btnS.className = 'px-2.5 py-0.5 bg-red-600 text-white rounded text-[11px] font-bold shadow-sm animate-pulse';
      }
    }

    function setLayout(layout) {
      const container = document.getElementById('tileContainer');
      const b5 = document.getElementById('btnLayout5x2');
      const b10 = document.getElementById('btnLayout10');
      if (layout === '5x2') {
        container.className = 'tile-grid-5x2';
        b5.className = 'px-2 py-0.5 bg-white border border-gray-400 rounded text-[11px] font-bold text-blue-700 shadow-sm';
        b10.className = 'px-2 py-0.5 bg-[#f5f4ea] border border-gray-400 rounded text-[11px] text-gray-700 hover:bg-white';
      } else {
        container.className = 'tile-grid-10col';
        b10.className = 'px-2 py-0.5 bg-white border border-gray-400 rounded text-[11px] font-bold text-blue-700 shadow-sm';
        b5.className = 'px-2 py-0.5 bg-[#f5f4ea] border border-gray-400 rounded text-[11px] text-gray-700 hover:bg-white';
      }
    }

    initUI();

    // 로그 실시간 스트리밍 루프
    setInterval(() => {
      const burst = currentMode === 'surge' ? 4 : 1;
      for (let b = 0; b < burst; b++) {
        SESSIONS.forEach(s => {
          if (Math.random() < (currentMode === 'surge' ? 0.85 : 0.45)) {
            generateLine(s);
          }
        });
      }
      renderAllTerms();
    }, 280);
  </script>
</body>
</html>
